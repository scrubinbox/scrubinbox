{
  "name": "scrubinbox",
  "version": "0.1.0",
  "description": "Open-source Gmail inbox cleanup tool. Self-host for free, or use the hosted version at scrubinbox.com.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.15"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/scrubinbox/scrubinbox.git"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "vite build && wrangler deploy -c wrangler.toml",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck:worker": "tsc --noEmit -p worker/tsconfig.json"
  },
  "dependencies": {
    "@fontsource/instrument-sans": "^5.3.0",
    "@neondatabase/serverless": "^1.2.0",
    "hono": "^4.13.13",
    "jose": "^6.2.12",
    "stripe": "^22.3.1",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.63.1",
    "@cloudflare/workers-types": "^5.20260714.1",
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@tailwindcss/postcss": "^4.3.3",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.29",
    "svelte": "^5.57.2",
    "tailwindcss": "^4.1.17",
    "terser": "^5.51.2",
    "typescript": "^7.0.2",
    "vite": "^7.3.7",
    "vitest": "^3.0.0",
    "wrangler": "^4.0.0"
  }
}
